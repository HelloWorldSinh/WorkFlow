# ==========================================
# WorkerBuilder - Root Git Ignore File
# ==========================================

# ------------------------------------------
# 1. Backend (Java / Spring Boot / Maven)
# ------------------------------------------
backend/target/
**/target/
**/*.class
backend/.mvn/wrapper/maven-wrapper.jar
**/build/
**/out/
*.jar
*.war
*.ear

# ------------------------------------------
# 2. Frontend (Node.js / Vue 3 / Vite)
# ------------------------------------------
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
**/dist-ssr/
**/*.local
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
*.timestamp-*-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.local
.env.*.local

# ------------------------------------------
# 3. IDEs and Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iml
*.iws
*.ipr

# Eclipse / STS
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ------------------------------------------
# 4. OS Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------
# 5. Scratch & Temporary Files
# ------------------------------------------
scratch/
